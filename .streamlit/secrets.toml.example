# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Cloud, add each key individually under App Settings → Secrets.
# secrets.toml is gitignored — this example file is safe to commit.

AFFINITY_API_KEY = ""
SLACK_BOT_TOKEN  = ""

# ── Google OAuth 2.0 (Streamlit native auth, v1.37+) ─────────────────────────
# See .streamlit/config.toml for redirect_uri and cookie_secret.
#
#  1. https://console.cloud.google.com → select or create a project
#  2. APIs & Services → OAuth consent screen
#     - User Type: Internal (restricts to your Google Workspace org)
#  3. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#     - Application type: Web application
#     - Authorised redirect URIs — append /oauth2callback to the base URL:
#         https://quona-benchmarking-kcstcmzvzhmrchxoael49m.streamlit.app/oauth2callback
#         http://localhost:8501/oauth2callback
#  4. Copy Client ID and Client Secret below

[auth.google]
client_id     = "151933219250-nj2m613g67taa3ffsj5s8d6tetgnmh61.apps.googleusercontent.com"
client_secret = ""
