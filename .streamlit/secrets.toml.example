# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Cloud, add each key individually under App Settings → Secrets.
# secrets.toml is gitignored — this example file is safe to commit.

AFFINITY_API_KEY = ""
SLACK_BOT_TOKEN  = ""

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# See auth.py for full setup instructions, or follow these steps:
#
#  1. https://console.cloud.google.com → select or create a project
#  2. APIs & Services → OAuth consent screen
#     - User Type: Internal (restricts to your Google Workspace org)
#  3. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#     - Application type: Web application
#     - Authorised redirect URIs — BASE URL ONLY, no path suffix:
#         https://quona-benchmarking-kcstcmzvzhmrchxoael49m.streamlit.app
#         http://localhost:8501
#     ⚠  Do NOT append /oauth2callback — Streamlit has no URL routing.
#        Google redirects to the base URL with ?code=… as a query param.
#  4. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID     = ""
GOOGLE_CLIENT_SECRET = ""
ALLOWED_DOMAIN       = "quona.com"
REDIRECT_URI         = "https://quona-benchmarking-kcstcmzvzhmrchxoael49m.streamlit.app"
