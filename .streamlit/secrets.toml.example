# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Cloud, add each key individually under App Settings → Secrets.
# secrets.toml is gitignored — this example file is safe to commit.

AFFINITY_API_KEY = ""
SLACK_BOT_TOKEN  = ""

# ── Streamlit native auth (v1.45+) ────────────────────────────────────────────
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication
#
# Setup steps:
#  1. https://console.cloud.google.com → select or create a project
#  2. APIs & Services → OAuth consent screen → User Type: Internal
#  3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#     - Application type: Web application
#     - Authorised redirect URIs:
#         https://quona-benchmarking-kcstcmzvzhmrchxoael49m.streamlit.app/oauth2callback
#         http://localhost:8501/oauth2callback
#  4. Copy Client ID and Client Secret into [auth.google] below
#  5. On Streamlit Cloud, also set [auth] redirect_uri to the deployed URL

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-32-random-chars"

[auth.google]
client_id           = "151933219250-nj2m613g67taa3ffsj5s8d6tetgnmh61.apps.googleusercontent.com"
client_secret       = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
